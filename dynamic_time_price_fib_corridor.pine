//@version=6
indicator("Dynamic Time-Price Fibonacci Corridor", shorttitle="DTPFC", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ============================================================================
// I. CONSTANTS
// ============================================================================

// Retracement zones (price moves from impulse end p1 back toward start p0).
// frac = 0.0 -> p1; frac = 1.0 -> p0.
FIB_Z1_LO = 0.382
FIB_Z1_HI = 0.500
FIB_Z2_LO = 0.500
FIB_Z2_HI = 0.618
FIB_Z3_LO = 0.618
FIB_Z3_HI = 0.786
FIB_Z4_LO = 0.786
FIB_Z4_HI = 1.000

// Breakout (extension) zones: price continues past p1 in the impulse direction.
// ext = 1.0 -> p1; ext = 1.272 -> p1 + 0.272 * (p1 - p0).
FIB_B1_LO = 1.000
FIB_B1_HI = 1.272
FIB_B2_LO = 1.272
FIB_B2_HI = 1.618

// ============================================================================
// II. USER INPUTS
// ============================================================================

// --- Current impulse ------------------------------------------------------
manualOverride  = input.bool(false, "Override with manual impulse", group="Current impulse", tooltip="OFF: the latest auto-detected impulse is used. The tentative-end detector (ATR retracement) reveals the prediction as soon as price reverses, well before the confirmed pivot arrives.\nON: the Start/End timestamps below pin the impulse. Direction is inferred from the close-to-close change between those two bars.")
manualStartTime = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Manual Start time", group="Current impulse", tooltip="The bar whose timestamp is closest to (and not exceeding) this value anchors the impulse start. Bars do not drift as new candles arrive.")
manualEndTime   = input.time(timestamp("01 Feb 2024 00:00 +0000"), "Manual End time",   group="Current impulse", tooltip="The bar whose timestamp is closest to (and not exceeding) this value anchors the impulse end. Must be after Start.")

// --- Impulse detection ---------------------------------------------------
pivLeft       = input.int(10,    "Pivot left bars",  minval=1, maxval=200, group="Detection", tooltip="A bar counts as a pivot only if its high (or low) is the most extreme over this many bars to its left.")
pivRight      = input.int(10,    "Pivot right bars", minval=1, maxval=200, group="Detection", tooltip="Confirmation lag in bars on the right. Confirmed pivots arrive this late; the tentative-end detector below bridges the gap.")
tentativeMult = input.float(0.7, "Tentative end — ATR retracement", minval=0.1, maxval=5.0, step=0.1, group="Detection", tooltip="As soon as price retraces from the running extremum by this multiple of ATR, the current impulse end is declared tentatively and the prediction is drawn. Smaller = earlier reveal (more noise), larger = later reveal (more lag).")
atrLen        = input.int(14,    "ATR length", minval=1, maxval=500, group="Detection", tooltip="Used by the tentative-end detector.")

// --- Statistics horizon and filters --------------------------------------
lookforwardBars  = input.int(60,    "Lookforward window (bars)", minval=1, maxval=2000, group="Statistics", tooltip="For each historical impulse, the script checks whether price entered each zone within this many bars after the impulse end. This is the user-controlled time horizon for both statistics and prediction.")
filterBySize     = input.bool(true, "Filter history by impulse size", group="Statistics", tooltip="If ON: only historical impulses whose |ΔP| is within the band below (multiples of the current impulse's |ΔP|) are counted.")
sizeMin          = input.float(0.5, "Size band — min × current",     minval=0.05, maxval=10.0, step=0.05, group="Statistics")
sizeMax          = input.float(2.0, "Size band — max × current",     minval=0.1,  maxval=20.0, step=0.05, group="Statistics")
filterByDuration = input.bool(false,"Filter history by impulse duration", group="Statistics", tooltip="If ON: only historical impulses whose duration is within the band below (multiples of the current impulse's duration) are counted.")
durMin           = input.float(0.5, "Duration band — min × current", minval=0.05, maxval=10.0, step=0.05, group="Statistics")
durMax           = input.float(2.0, "Duration band — max × current", minval=0.1,  maxval=20.0, step=0.05, group="Statistics")
maxAge           = input.int(50,    "Max historical impulses to keep", minval=1, maxval=500, group="Statistics", tooltip="Only the most recent N same-direction impulses are considered, before size/duration filters are applied.")

// --- Display -------------------------------------------------------------
panelCorner   = input.string("Top Right", "Stats panel position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Display")
boxOpacity    = input.int(75, "Box transparency (0=solid, 95=near-invisible)", minval=0, maxval=95, group="Display")
drawHistLines = input.bool(true,  "Draw historical impulse lines", group="Display", tooltip="Draws each same-direction historical impulse used in the statistics as a thin coloured line (green = touched at least one retracement zone, red = invalidated past start, gray = neither).")
drawHistZones = input.bool(false, "Draw retroactive zone boxes on historical impulses", group="Display")
col_z1        = input.color(color.green,   "Z1 0.382–0.5",   group="Display")
col_z2        = input.color(color.yellow,  "Z2 0.5–0.618",   group="Display")
col_z3        = input.color(color.orange,  "Z3 0.618–0.786", group="Display")
col_z4        = input.color(color.red,     "Z4 0.786–1.0",   group="Display")
col_b1        = input.color(color.purple,  "B1 1.0–1.272",   group="Display")
col_b2        = input.color(color.fuchsia, "B2 1.272–1.618", group="Display")

// ============================================================================
// III. TYPES AND PERSISTENT STATE
// ============================================================================

// One detected impulse and its zone-touch evaluation record.
type Impulse
    int   t0          = 0
    float p0          = 0.0
    int   t1          = 0
    float p1          = 0.0
    int   bar_t1      = 0       // bar_index at which t1 was last set
    bool  is_up       = false
    bool  hit_z1      = false
    bool  hit_z2      = false
    bool  hit_z3      = false
    bool  hit_z4      = false
    bool  hit_b1      = false
    bool  hit_b2      = false
    int   tau_z1      = 0
    int   tau_z2      = 0
    int   tau_z3      = 0
    int   tau_z4      = 0
    int   tau_b1      = 0
    int   tau_b2      = 0
    bool  invalidated = false   // price retraced past p0 (impulse wiped out)
    bool  tentative   = true    // true until the confirmed opposite pivot arrives
    bool  settled     = false   // true once the lookforward window has elapsed
    int   bars_eval   = 0       // bars elapsed since t1

var array<Impulse> impulses = array.new<Impulse>()

// Last confirmed pivot. is_high == true means swing high.
var int   lp_time    = 0
var float lp_price   = 0.0
var bool  lp_is_high = false
var int   lp_count   = 0

// Running extremum since the last confirmed pivot. Feeds the tentative-end
// detector and pins the in-progress impulse's t1/p1 before pivot confirmation.
var int   run_time  = 0
var float run_price = 0.0
var int   run_bar   = 0
var bool  run_valid = false

// The in-progress impulse. Replaces the latest-array-entry pattern of the
// previous version. Persists across bars and is updated in place.
var Impulse current = na

// Manual impulse: track the bar whose time is closest to (and not exceeding)
// each configured timestamp. These vars hold that bar's data on the last bar.
var int   ms_time  = na
var float ms_high  = na
var float ms_low   = na
var float ms_close = na
var int   me_time  = na
var float me_high  = na
var float me_low   = na
var float me_close = na

// Persistent handles for drawings so we can wipe them each redraw.
var array<box>   draw_boxes  = array.new<box>()
var array<line>  draw_lines  = array.new<line>()
var array<label> draw_labels = array.new<label>()
var table        stats_tbl   = na


// ============================================================================
// IV. HELPER FUNCTIONS
// ============================================================================

// Retracement zone bounds: frac in [0, 1], where 0 = p1 and 1 = p0.
// Returns [low, high] price range covered by the [frac_lo, frac_hi] band.
retr_bounds(float p0, float p1, float frac_lo, float frac_hi) =>
    a = p1 - frac_lo * (p1 - p0)
    b = p1 - frac_hi * (p1 - p0)
    [math.min(a, b), math.max(a, b)]

// Extension zone bounds: frac > 1; frac = 1 -> p1, frac = 1.272 -> p1 + 0.272 * (p1 - p0).
ext_bounds(float p0, float p1, float frac_lo, float frac_hi) =>
    a = p1 + (frac_lo - 1.0) * (p1 - p0)
    b = p1 + (frac_hi - 1.0) * (p1 - p0)
    [math.min(a, b), math.max(a, b)]

// Format a millisecond duration as a short human-readable string.
fmt_duration(int ms) =>
    abs_ms = math.abs(ms)
    days   = math.floor(abs_ms / 86400000)
    hours  = math.floor((abs_ms % 86400000) / 3600000)
    mins   = math.floor((abs_ms % 3600000) / 60000)
    days > 0 ? str.tostring(days) + "d " + str.tostring(hours) + "h" : hours > 0 ? str.tostring(hours) + "h " + str.tostring(mins) + "m" : str.tostring(mins) + "m"

// Translate panel-corner string into a Pine position constant.
panel_pos(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right

// Draw a Fib-zone prediction box and its hit-rate label.
// Globals it mutates: draw_boxes, draw_labels. Globals it reads: boxOpacity.
draw_zone_box(int x_from, int x_to, float y_lo, float y_hi, color base_col, float win_rate, int sample_count) =>
    bc  = color.new(base_col, boxOpacity)
    bb  = box.new(x_from, y_hi, x_to, y_lo, xloc=xloc.bar_time, bgcolor=bc, border_color=color.new(base_col, 30), border_width=1)
    array.push(draw_boxes, bb)
    txt = sample_count > 0 ? str.tostring(math.round(win_rate * 100.0)) + "%" : "—"
    lab = label.new(int((x_from + x_to) / 2), (y_hi + y_lo) * 0.5, txt, xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.normal)
    array.push(draw_labels, lab)

// Apply one bar (hi/lo/time) to an unsettled impulse: update zone-hit flags,
// extension-hit flags, and the past-p0 invalidation flag.
update_impulse(Impulse imp, float hi, float lo, int tt) =>
    if not imp.settled
        tau = tt - imp.t1
        [z1_lo, z1_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z1_LO, FIB_Z1_HI)
        [z2_lo, z2_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z2_LO, FIB_Z2_HI)
        [z3_lo, z3_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z3_LO, FIB_Z3_HI)
        [z4_lo, z4_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z4_LO, FIB_Z4_HI)
        [b1_lo, b1_hi] = ext_bounds (imp.p0, imp.p1, FIB_B1_LO, FIB_B1_HI)
        [b2_lo, b2_hi] = ext_bounds (imp.p0, imp.p1, FIB_B2_LO, FIB_B2_HI)
        if not imp.hit_z1 and hi >= z1_lo and lo <= z1_hi
            imp.hit_z1 := true
            imp.tau_z1 := tau
        if not imp.hit_z2 and hi >= z2_lo and lo <= z2_hi
            imp.hit_z2 := true
            imp.tau_z2 := tau
        if not imp.hit_z3 and hi >= z3_lo and lo <= z3_hi
            imp.hit_z3 := true
            imp.tau_z3 := tau
        if not imp.hit_z4 and hi >= z4_lo and lo <= z4_hi
            imp.hit_z4 := true
            imp.tau_z4 := tau
        if not imp.hit_b1 and hi >= b1_lo and lo <= b1_hi
            imp.hit_b1 := true
            imp.tau_b1 := tau
        if not imp.hit_b2 and hi >= b2_lo and lo <= b2_hi
            imp.hit_b2 := true
            imp.tau_b2 := tau
        if not imp.invalidated
            inv = (imp.is_up and lo < imp.p0) or ((not imp.is_up) and hi > imp.p0)
            if inv
                imp.invalidated := true

// ============================================================================
// V. PER-BAR PIVOT DETECTION AND IMPULSE TRACKING
// ============================================================================

ph  = ta.pivothigh(pivLeft, pivRight)
pl  = ta.pivotlow (pivLeft, pivRight)
atr = ta.atr(atrLen)

new_high = not na(ph)
new_low  = not na(pl)

// --- Confirmed pivot handling ---------------------------------------------
if new_high or new_low
    piv_price   = new_high ? ph : pl
    piv_is_high = new_high
    piv_time    = time[pivRight]
    piv_bar     = bar_index - pivRight

    if lp_count == 0
        lp_time    := piv_time
        lp_price   := piv_price
        lp_is_high := piv_is_high
        lp_count   := 1
        run_valid  := false
    else if lp_is_high == piv_is_high
        if (piv_is_high and piv_price > lp_price) or ((not piv_is_high) and piv_price < lp_price)
            lp_time   := piv_time
            lp_price  := piv_price
            run_valid := false
            if not na(current) and current.tentative
                current := na
    else
        // Alternating direction — a complete impulse is now confirmed.
        if na(current)
            c = Impulse.new()
            c.t0     := lp_time
            c.p0     := lp_price
            c.t1     := piv_time
            c.p1     := piv_price
            c.bar_t1 := piv_bar
            c.is_up  := not lp_is_high
            current  := c
        else
            // Promoting tentative -> confirmed: replace endpoint and discard the
            // hit-flag state that was evaluated against the obsolete t1/p1.
            current.t1          := piv_time
            current.p1          := piv_price
            current.bar_t1      := piv_bar
            current.hit_z1      := false
            current.hit_z2      := false
            current.hit_z3      := false
            current.hit_z4      := false
            current.hit_b1      := false
            current.hit_b2      := false
            current.tau_z1      := 0
            current.tau_z2      := 0
            current.tau_z3      := 0
            current.tau_z4      := 0
            current.tau_b1      := 0
            current.tau_b2      := 0
            current.invalidated := false
        current.tentative := false

        // Catch up zone-hit tracking for the lag bars [pivRight-1 .. 1].
        // Pine v6 auto-selects negative direction when init > end; `by` must be positive.
        if pivRight > 1
            for k = pivRight - 1 to 1
                update_impulse(current, high[k], low[k], time[k])
        current.bars_eval := pivRight - 1

        array.push(impulses, current)
        current    := na
        lp_time    := piv_time
        lp_price   := piv_price
        lp_is_high := piv_is_high
        lp_count   += 1
        run_valid  := false

// --- Running extremum since last confirmed pivot --------------------------
// After a low-pivot we expect an UP move (track max high); after a high-pivot
// we expect DOWN (track min low). A new extremum invalidates any tentative end.
if lp_count > 0
    expect_up = not lp_is_high
    if expect_up
        if not run_valid or high > run_price
            run_price := high
            run_time  := time
            run_bar   := bar_index
            run_valid := true
            if not na(current) and current.tentative
                current := na
    else
        if not run_valid or low < run_price
            run_price := low
            run_time  := time
            run_bar   := bar_index
            run_valid := true
            if not na(current) and current.tentative
                current := na

// --- Tentative-end trigger via ATR retracement ----------------------------
if lp_count > 0 and run_valid and na(current) and not na(atr) and atr > 0
    expect_up   = not lp_is_high
    retracement = expect_up ? run_price - low : high - run_price
    if retracement >= tentativeMult * atr
        c = Impulse.new()
        c.t0        := lp_time
        c.p0        := lp_price
        c.t1        := run_time
        c.p1        := run_price
        c.bar_t1    := run_bar
        c.is_up     := expect_up
        c.tentative := true
        c.bars_eval := bar_index - run_bar
        current     := c

// --- Per-bar zone-hit update for unsettled impulses -----------------------
if not na(current)
    update_impulse(current, high, low, time)
    current.bars_eval += 1
    if current.bars_eval >= lookforwardBars
        current.settled := true

if array.size(impulses) > 0
    n_imp = array.size(impulses)
    for i = 0 to n_imp - 1
        imp = array.get(impulses, n_imp - 1 - i)
        if not imp.settled
            update_impulse(imp, high, low, time)
            imp.bars_eval += 1
            if imp.bars_eval >= lookforwardBars
                imp.settled := true

// --- Manual impulse: capture the bar closest to (and not exceeding) target -
if time <= manualStartTime
    ms_time  := time
    ms_high  := high
    ms_low   := low
    ms_close := close
if time <= manualEndTime
    me_time  := time
    me_high  := high
    me_low   := low
    me_close := close

// ============================================================================
// VI. LAST-BAR AGGREGATION AND DRAWING
// ============================================================================

clear_drawings() =>
    if array.size(draw_boxes) > 0
        for b in draw_boxes
            box.delete(b)
        array.clear(draw_boxes)
    if array.size(draw_lines) > 0
        for ln in draw_lines
            line.delete(ln)
        array.clear(draw_lines)
    if array.size(draw_labels) > 0
        for lb in draw_labels
            label.delete(lb)
        array.clear(draw_labels)

// Resolve the "current impulse" source. In auto mode it is the in-progress
// tentative impulse (or the latest confirmed one); in manual mode it is built
// from the two configured timestamps with direction inferred from price action.
int   src_t0     = 0
float src_p0     = 0.0
int   src_t1     = 0
float src_p1     = 0.0
bool  src_is_up  = false
bool  src_tent   = false
bool  src_valid  = false
// 0 = valid; 1 = manual times invalid; 2 = no auto impulse yet.
int   src_reason = 0

if barstate.islast
    if manualOverride
        if not na(ms_time) and not na(me_time) and me_time > ms_time
            src_t0     := ms_time
            src_t1     := me_time
            src_is_up  := me_close > ms_close
            src_p0     := src_is_up ? ms_low  : ms_high
            src_p1     := src_is_up ? me_high : me_low
            src_valid  := src_p0 != src_p1
            src_reason := src_valid ? 0 : 1
        else
            src_reason := 1
    else
        if not na(current)
            src_t0    := current.t0
            src_p0    := current.p0
            src_t1    := current.t1
            src_p1    := current.p1
            src_is_up := current.is_up
            src_tent  := current.tentative
            src_valid := true
        else if array.size(impulses) > 0
            li = array.get(impulses, array.size(impulses) - 1)
            src_t0    := li.t0
            src_p0    := li.p0
            src_t1    := li.t1
            src_p1    := li.p1
            src_is_up := li.is_up
            src_valid := true
        else
            src_reason := 2

// Filtered same-direction historical sample, built on the last bar.
var array<Impulse> filtered = array.new<Impulse>()

if barstate.islast
    clear_drawings()
    array.clear(filtered)

    // ----- Build filtered sample, most-recent-first up to maxAge matches ---
    float curRange = math.abs(src_p1 - src_p0)
    int   curDur   = src_t1 - src_t0

    if src_valid and array.size(impulses) > 0
        kept = 0
        i = array.size(impulses) - 1
        while i >= 0 and kept < maxAge
            imp = array.get(impulses, i)
            if imp.is_up == src_is_up and imp.settled
                impRange = math.abs(imp.p1 - imp.p0)
                impDur   = imp.t1 - imp.t0
                sizeOk = not filterBySize or (curRange > 0 and impRange >= sizeMin * curRange and impRange <= sizeMax * curRange)
                durOk  = not filterByDuration or (curDur > 0 and impDur >= durMin * curDur and impDur <= durMax * curDur)
                if sizeOk and durOk
                    array.unshift(filtered, imp)
                kept += 1
            i -= 1

    // ----- Aggregate zone-hit statistics from the filtered sample ----------
    int n_total = 0
    int n_z1    = 0
    int n_z2    = 0
    int n_z3    = 0
    int n_z4    = 0
    int n_b1    = 0
    int n_b2    = 0
    int n_inv   = 0
    float sum_t1 = 0.0
    float sum_t2 = 0.0
    float sum_t3 = 0.0
    float sum_t4 = 0.0
    float sum_b1 = 0.0
    float sum_b2 = 0.0
    float sq_t1  = 0.0
    float sq_t2  = 0.0
    float sq_t3  = 0.0
    float sq_t4  = 0.0
    float sq_b1  = 0.0
    float sq_b2  = 0.0

    if array.size(filtered) > 0
        for i = 0 to array.size(filtered) - 1
            imp = array.get(filtered, i)
            n_total += 1
            if imp.hit_z1
                n_z1 += 1
                sum_t1 += imp.tau_z1
                sq_t1  += imp.tau_z1 * imp.tau_z1
            if imp.hit_z2
                n_z2 += 1
                sum_t2 += imp.tau_z2
                sq_t2  += imp.tau_z2 * imp.tau_z2
            if imp.hit_z3
                n_z3 += 1
                sum_t3 += imp.tau_z3
                sq_t3  += imp.tau_z3 * imp.tau_z3
            if imp.hit_z4
                n_z4 += 1
                sum_t4 += imp.tau_z4
                sq_t4  += imp.tau_z4 * imp.tau_z4
            if imp.hit_b1
                n_b1 += 1
                sum_b1 += imp.tau_b1
                sq_b1  += imp.tau_b1 * imp.tau_b1
            if imp.hit_b2
                n_b2 += 1
                sum_b2 += imp.tau_b2
                sq_b2  += imp.tau_b2 * imp.tau_b2
            if imp.invalidated
                n_inv += 1

    wr_z1 = n_total > 0 ? n_z1 / float(n_total) : 0.0
    wr_z2 = n_total > 0 ? n_z2 / float(n_total) : 0.0
    wr_z3 = n_total > 0 ? n_z3 / float(n_total) : 0.0
    wr_z4 = n_total > 0 ? n_z4 / float(n_total) : 0.0
    wr_b1 = n_total > 0 ? n_b1 / float(n_total) : 0.0
    wr_b2 = n_total > 0 ? n_b2 / float(n_total) : 0.0
    wr_inv = n_total > 0 ? n_inv / float(n_total) : 0.0
    avg_t1 = n_z1 > 0 ? sum_t1 / n_z1 : 0.0
    avg_t2 = n_z2 > 0 ? sum_t2 / n_z2 : 0.0
    avg_t3 = n_z3 > 0 ? sum_t3 / n_z3 : 0.0
    avg_t4 = n_z4 > 0 ? sum_t4 / n_z4 : 0.0
    avg_b1 = n_b1 > 0 ? sum_b1 / n_b1 : 0.0
    avg_b2 = n_b2 > 0 ? sum_b2 / n_b2 : 0.0
    sd_t1 = n_z1 > 1 ? math.sqrt(math.max(0.0, sq_t1 / n_z1 - avg_t1 * avg_t1)) : 0.0
    sd_t2 = n_z2 > 1 ? math.sqrt(math.max(0.0, sq_t2 / n_z2 - avg_t2 * avg_t2)) : 0.0
    sd_t3 = n_z3 > 1 ? math.sqrt(math.max(0.0, sq_t3 / n_z3 - avg_t3 * avg_t3)) : 0.0
    sd_t4 = n_z4 > 1 ? math.sqrt(math.max(0.0, sq_t4 / n_z4 - avg_t4 * avg_t4)) : 0.0
    sd_b1 = n_b1 > 1 ? math.sqrt(math.max(0.0, sq_b1 / n_b1 - avg_b1 * avg_b1)) : 0.0
    sd_b2 = n_b2 > 1 ? math.sqrt(math.max(0.0, sq_b2 / n_b2 - avg_b2 * avg_b2)) : 0.0

    // ----- Draw current impulse + prediction boxes -------------------------
    if src_valid
        impulse_col = src_tent ? color.new(color.yellow, 0) : color.new(color.white, 0)
        ln = line.new(src_t0, src_p0, src_t1, src_p1, xloc=xloc.bar_time, color=impulse_col, width=2)
        array.push(draw_lines, ln)
        lb0 = label.new(src_t0, src_p0, "Start", xloc=xloc.bar_time, style=src_is_up ? label.style_label_up : label.style_label_down, color=color.new(color.gray, 50), textcolor=color.white, size=size.small)
        end_text = src_tent ? "End (tentative)" : "End"
        lb1 = label.new(src_t1, src_p1, end_text, xloc=xloc.bar_time, style=src_is_up ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 50), textcolor=color.white, size=size.small)
        array.push(draw_labels, lb0)
        array.push(draw_labels, lb1)

        [pz1_lo, pz1_hi] = retr_bounds(src_p0, src_p1, FIB_Z1_LO, FIB_Z1_HI)
        [pz2_lo, pz2_hi] = retr_bounds(src_p0, src_p1, FIB_Z2_LO, FIB_Z2_HI)
        [pz3_lo, pz3_hi] = retr_bounds(src_p0, src_p1, FIB_Z3_LO, FIB_Z3_HI)
        [pz4_lo, pz4_hi] = retr_bounds(src_p0, src_p1, FIB_Z4_LO, FIB_Z4_HI)
        [pb1_lo, pb1_hi] = ext_bounds (src_p0, src_p1, FIB_B1_LO, FIB_B1_HI)
        [pb2_lo, pb2_hi] = ext_bounds (src_p0, src_p1, FIB_B2_LO, FIB_B2_HI)

        // Per-zone time windows: historical mean ± stdev when samples exist,
        // else fall back to the full lookforward window.
        bar_ms = timeframe.in_seconds(timeframe.period) * 1000
        max_w  = lookforwardBars * bar_ms

        w_lo_1 = n_z1 > 0 ? math.max(0.0, avg_t1 - sd_t1) : 0.0
        w_hi_1 = n_z1 > 0 ? avg_t1 + sd_t1                : float(max_w)
        w_lo_2 = n_z2 > 0 ? math.max(0.0, avg_t2 - sd_t2) : 0.0
        w_hi_2 = n_z2 > 0 ? avg_t2 + sd_t2                : float(max_w)
        w_lo_3 = n_z3 > 0 ? math.max(0.0, avg_t3 - sd_t3) : 0.0
        w_hi_3 = n_z3 > 0 ? avg_t3 + sd_t3                : float(max_w)
        w_lo_4 = n_z4 > 0 ? math.max(0.0, avg_t4 - sd_t4) : 0.0
        w_hi_4 = n_z4 > 0 ? avg_t4 + sd_t4                : float(max_w)
        w_lo_b1 = n_b1 > 0 ? math.max(0.0, avg_b1 - sd_b1) : 0.0
        w_hi_b1 = n_b1 > 0 ? avg_b1 + sd_b1                : float(max_w)
        w_lo_b2 = n_b2 > 0 ? math.max(0.0, avg_b2 - sd_b2) : 0.0
        w_hi_b2 = n_b2 > 0 ? avg_b2 + sd_b2                : float(max_w)

        draw_zone_box(src_t1 + int(w_lo_1),  src_t1 + int(w_hi_1),  pz1_lo, pz1_hi, col_z1, wr_z1, n_total)
        draw_zone_box(src_t1 + int(w_lo_2),  src_t1 + int(w_hi_2),  pz2_lo, pz2_hi, col_z2, wr_z2, n_total)
        draw_zone_box(src_t1 + int(w_lo_3),  src_t1 + int(w_hi_3),  pz3_lo, pz3_hi, col_z3, wr_z3, n_total)
        draw_zone_box(src_t1 + int(w_lo_4),  src_t1 + int(w_hi_4),  pz4_lo, pz4_hi, col_z4, wr_z4, n_total)
        draw_zone_box(src_t1 + int(w_lo_b1), src_t1 + int(w_hi_b1), pb1_lo, pb1_hi, col_b1, wr_b1, n_total)
        draw_zone_box(src_t1 + int(w_lo_b2), src_t1 + int(w_hi_b2), pb2_lo, pb2_hi, col_b2, wr_b2, n_total)

        // ----- Historical impulse lines (filtered same-direction sample) ----
        if drawHistLines and array.size(filtered) > 0
            for i = 0 to array.size(filtered) - 1
                imp = array.get(filtered, i)
                anyHit = imp.hit_z1 or imp.hit_z2 or imp.hit_z3 or imp.hit_z4
                hcol   = imp.invalidated ? color.new(color.red, 30) : anyHit ? color.new(color.green, 30) : color.new(color.gray, 30)
                lnh    = line.new(imp.t0, imp.p0, imp.t1, imp.p1, xloc=xloc.bar_time, color=hcol, width=1)
                array.push(draw_lines, lnh)

        // ----- Optional retroactive zone boxes on each historical impulse ---
        if drawHistZones and array.size(filtered) > 0
            for i = 0 to array.size(filtered) - 1
                imp = array.get(filtered, i)
                [hz1_lo, hz1_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z1_LO, FIB_Z1_HI)
                [hz2_lo, hz2_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z2_LO, FIB_Z2_HI)
                [hz3_lo, hz3_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z3_LO, FIB_Z3_HI)
                [hz4_lo, hz4_hi] = retr_bounds(imp.p0, imp.p1, FIB_Z4_LO, FIB_Z4_HI)
                end_t = imp.t1 + int(max_w)
                hb1 = box.new(imp.t1, hz1_hi, end_t, hz1_lo, xloc=xloc.bar_time, bgcolor=color.new(col_z1, 92), border_color=imp.hit_z1 ? color.new(col_z1, 30) : color.new(color.gray, 70), border_width=1)
                hb2 = box.new(imp.t1, hz2_hi, end_t, hz2_lo, xloc=xloc.bar_time, bgcolor=color.new(col_z2, 92), border_color=imp.hit_z2 ? color.new(col_z2, 30) : color.new(color.gray, 70), border_width=1)
                hb3 = box.new(imp.t1, hz3_hi, end_t, hz3_lo, xloc=xloc.bar_time, bgcolor=color.new(col_z3, 92), border_color=imp.hit_z3 ? color.new(col_z3, 30) : color.new(color.gray, 70), border_width=1)
                hb4 = box.new(imp.t1, hz4_hi, end_t, hz4_lo, xloc=xloc.bar_time, bgcolor=color.new(col_z4, 92), border_color=imp.hit_z4 ? color.new(col_z4, 30) : color.new(color.gray, 70), border_width=1)
                array.push(draw_boxes, hb1)
                array.push(draw_boxes, hb2)
                array.push(draw_boxes, hb3)
                array.push(draw_boxes, hb4)

    // ----- Stats table -----------------------------------------------------
    if not na(stats_tbl)
        table.delete(stats_tbl)
    stats_tbl := table.new(panel_pos(panelCorner), 4, 9, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 50), border_width=1)

    title = "DTPFC" + (src_valid and src_tent ? " (tentative)" : "")
    table.cell(stats_tbl, 0, 0, title, text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.merge_cells(stats_tbl, 0, 0, 3, 0)

    if not src_valid
        msg = src_reason == 1 ? "Manual times invalid — End must be after Start and both within chart history (Settings → Current impulse)." : src_reason == 2 ? "No detected impulse yet — wait for first pivots, decrease Pivot bars, or enable manual override." : "No current impulse."
        table.cell(stats_tbl, 0, 1, msg, text_color=color.yellow, text_size=size.small)
        table.merge_cells(stats_tbl, 0, 1, 3, 1)
    else
        table.cell(stats_tbl, 0, 1, "Zone",     text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 1, "Hit-rate", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(stats_tbl, 2, 1, "Avg τ",    text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        table.cell(stats_tbl, 3, 1, "Samples",  text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)

        table.cell(stats_tbl, 0, 2, "Z1 0.382–0.5",   text_color=color.white, bgcolor=color.new(col_z1, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 2, n_total > 0 ? str.tostring(math.round(wr_z1 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 2, n_z1 > 0 ? fmt_duration(int(avg_t1)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 2, str.tostring(n_z1) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 3, "Z2 0.5–0.618", text_color=color.white, bgcolor=color.new(col_z2, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 3, n_total > 0 ? str.tostring(math.round(wr_z2 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 3, n_z2 > 0 ? fmt_duration(int(avg_t2)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 3, str.tostring(n_z2) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 4, "Z3 0.618–0.786", text_color=color.white, bgcolor=color.new(col_z3, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 4, n_total > 0 ? str.tostring(math.round(wr_z3 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 4, n_z3 > 0 ? fmt_duration(int(avg_t3)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 4, str.tostring(n_z3) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 5, "Z4 0.786–1.0", text_color=color.white, bgcolor=color.new(col_z4, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 5, n_total > 0 ? str.tostring(math.round(wr_z4 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 5, n_z4 > 0 ? fmt_duration(int(avg_t4)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 5, str.tostring(n_z4) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 6, "B1 1.0–1.272", text_color=color.white, bgcolor=color.new(col_b1, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 6, n_total > 0 ? str.tostring(math.round(wr_b1 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 6, n_b1 > 0 ? fmt_duration(int(avg_b1)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 6, str.tostring(n_b1) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 7, "B2 1.272–1.618", text_color=color.white, bgcolor=color.new(col_b2, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 7, n_total > 0 ? str.tostring(math.round(wr_b2 * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 7, n_b2 > 0 ? fmt_duration(int(avg_b2)) : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 7, str.tostring(n_b2) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

        table.cell(stats_tbl, 0, 8, "Invalidated", text_color=color.white, bgcolor=color.new(color.maroon, 70), text_size=size.small)
        table.cell(stats_tbl, 1, 8, n_total > 0 ? str.tostring(math.round(wr_inv * 100.0)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 2, 8, "—", text_color=color.white, text_size=size.small)
        table.cell(stats_tbl, 3, 8, str.tostring(n_inv) + "/" + str.tostring(n_total), text_color=color.white, text_size=size.small)

